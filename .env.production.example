# Copy to .env.production for LOCAL production-mode runs. On a host (Render/Railway) set these as environment variables instead.
NODE_ENV=production
PORT=3000

# Sepolia testnet via Infura or Alchemy (Mainnet: chain id 1 and a mainnet RPC URL)
WEB3_PROVIDER=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
CHAIN_ID=11155111
NETWORK_NAME=Sepolia Testnet

# Filled automatically by `npm run deploy:sepolia`
SUPPLY_CHAIN_ADDRESS=
ROLE_MANAGER_ADDRESS=

# Use ONE of these for deploying. Never commit them. Use a brand new wallet with testnet ETH only.
DEPLOYER_PRIVATE_KEY=
MNEMONIC=

# Your deployed site, e.g. https://sct.onrender.com  (restricts CORS in production)
CORS_ORIGIN=
