# Copy to .env.development or .env.production and fill in.
NODE_ENV=development
PORT=3000

# RPC endpoint: Ganache locally, Infura/Alchemy URL for Sepolia/mainnet
WEB3_PROVIDER=http://127.0.0.1:7545
CHAIN_ID=1337
NETWORK_NAME=Ganache Local

# Filled automatically by `npm run deploy:*`
SUPPLY_CHAIN_ADDRESS=
ROLE_MANAGER_ADDRESS=

# Dev: private key of a Ganache account (deployer).  Prod: leave empty and use MNEMONIC.
DEPLOYER_PRIVATE_KEY=
MNEMONIC=

# Optional extra allowed CORS origin in production
CORS_ORIGIN=
